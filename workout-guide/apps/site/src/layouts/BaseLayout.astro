---
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { withBase } from '../lib/paths';
import '../styles/global.css';

type Props = {
  title: string;
  description: string;
  image?: string;
};

const { title, description, image = withBase('og.svg') } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(image.replace(/^\//, ''), Astro.site);
const swPath = withBase('sw.js');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#101010" />
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={withBase('favicon.svg')} type="image/svg+xml" />
    <link rel="manifest" href={withBase('manifest.webmanifest')} />
    <link rel="apple-touch-icon" href={withBase('icons/apple-touch-icon.png')} />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="FitSplit" />
    <meta name="mobile-web-app-capable" content="yes" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    <script define:vars={{ swPath }} is:inline>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register(swPath).catch(() => {
            // Offline support is a progressive enhancement; ignore registration failures.
          });
        });
      }
    </script>
    <script>
      import { getSvgPath } from 'figma-squircle';

      const applySquircle = (element: HTMLElement) => {
        const { width, height } = element.getBoundingClientRect();
        if (width === 0 || height === 0) return;
        const radius = Number(element.dataset.radius ?? 24);
        const path = getSvgPath({
          width,
          height,
          cornerRadius: Math.min(radius, width / 2, height / 2),
          cornerSmoothing: 0.8,
          preserveSmoothing: true,
        });
        element.style.clipPath = `path("${path}")`;
      };

      const squircleElements = Array.from(document.querySelectorAll<HTMLElement>('[data-squircle]'));
      const observer = new ResizeObserver((entries) => {
        for (const entry of entries) applySquircle(entry.target as HTMLElement);
      });
      for (const element of squircleElements) {
        applySquircle(element);
        observer.observe(element);
      }

      const FRAME_INTERVAL_MS = 450;
      const frameElements = Array.from(document.querySelectorAll<HTMLElement>('[data-frames]'));
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (frameElements.length > 0 && !reduceMotion) {
        const state = new Map<HTMLElement, { frames: string[]; index: number; direction: 1 | -1 }>();
        for (const element of frameElements) {
          try {
            const frames = JSON.parse(element.dataset.frames ?? '[]') as string[];
            if (frames.length > 1) state.set(element, { frames, index: 0, direction: 1 });
          } catch {
            // Ignore malformed frame data.
          }
        }

        const active = new Set<HTMLElement>();
        const frameObserver = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) active.add(entry.target as HTMLElement);
              else active.delete(entry.target as HTMLElement);
            }
          },
          { threshold: 0.1 },
        );
        for (const element of state.keys()) frameObserver.observe(element);

        const setFrame = (element: HTMLElement, url: string) => {
          if (element instanceof HTMLImageElement) {
            element.src = url;
            return;
          }
          element.style.setProperty('mask-image', `url(${url})`);
          element.style.setProperty('-webkit-mask-image', `url(${url})`);
        };

        let lastTick = 0;
        const tick = (timestamp: number) => {
          if (timestamp - lastTick >= FRAME_INTERVAL_MS) {
            lastTick = timestamp;
            for (const element of active) {
              const entry = state.get(element);
              if (!entry) continue;
              entry.index += entry.direction;
              if (entry.index === entry.frames.length - 1 || entry.index === 0) entry.direction *= -1;
              setFrame(element, entry.frames[entry.index]);
            }
          }
          requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      }
    </script>
  </body>
</html>
