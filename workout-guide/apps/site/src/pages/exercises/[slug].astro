---
import { exercises, type Exercise } from '@bryllim/workout-guide';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { frameUrl, withBase } from '../../lib/paths';
import { muscleColor } from '../../lib/muscleColor';

export function getStaticPaths() {
  return exercises.map((exercise) => ({ params: { slug: exercise.slug }, props: { exercise } }));
}

type Props = { exercise: Exercise };
const { exercise } = Astro.props;
const typeLabel = exercise.exerciseType.split('_').map((word) => word[0].toUpperCase() + word.slice(1)).join(' ');
const tint = muscleColor(exercise.primaryMuscle);
---

<BaseLayout title={`${exercise.name} — FitSplit`} description={`How to do the ${exercise.name}: full illustrated form, muscles worked, and equipment needed.`} image={frameUrl(exercise.slug, 1)}>
  <article class="page-shell">
    <header class="detail-hero">
      <div class="detail-copy">
        <a class="breadcrumb" href={withBase('exercises/')}>← All exercises</a>
        <p class="eyebrow">{typeLabel}</p><h1>{exercise.name}</h1><p>Follow the full range of motion, from start to finish.</p>
        <ul class="tag-list" aria-label="Exercise summary"><li class="tag" data-squircle data-radius="14">{exercise.equipment}</li><li class="tag" data-squircle data-radius="14">{exercise.primaryMuscle}</li>{exercise.isStretch && <li class="tag" data-squircle data-radius="14">Stretch</li>}</ul>
      </div>
      <div class="detail-featured" data-squircle data-radius="64"><span class="frame-mask" role="img" aria-label={`${exercise.name}, middle position`} data-frames={JSON.stringify(exercise.frames.map((frame) => frameUrl(exercise.slug, frame)))} style={`--frame-tint:${tint}; -webkit-mask-image:url(${frameUrl(exercise.slug, 2)}); mask-image:url(${frameUrl(exercise.slug, 2)})`} /></div>
    </header>

    <section class="section" aria-labelledby="frames-title">
      <div class="section-heading"><div><p class="eyebrow">Step by step</p><h2 id="frames-title">The full movement.</h2></div><p>Three positions, start to finish.</p></div>
      <div class="frame-grid">
        {exercise.frames.map((frame) => <div class="frame-card" data-squircle data-radius="32"><div class="card-stage" data-squircle data-radius="22"><span class="frame-mask" role="img" aria-label={`${exercise.name}, frame ${frame.index}`} style={`--frame-tint:${tint}; -webkit-mask-image:url(${frameUrl(exercise.slug, frame)}); mask-image:url(${frameUrl(exercise.slug, frame)})`} /></div><div class="frame-meta"><p>Frame {frame.index}</p><a href={frameUrl(exercise.slug, frame)} download={`${exercise.slug}-frame-${frame.index}.svg`}>Download</a></div></div>)}
      </div>
    </section>

    <section class="section guide-layout" aria-labelledby="details-title">
      <div><p class="eyebrow">At a glance</p><h2 id="details-title">Exercise details.</h2></div>
      <dl class="metadata-grid"><div class="metadata-card" data-squircle data-radius="32"><dt>Equipment</dt><dd>{exercise.equipment}</dd></div><div class="metadata-card" data-squircle data-radius="32"><dt>Primary muscle</dt><dd>{exercise.primaryMuscle}</dd></div><div class="metadata-card" data-squircle data-radius="32"><dt>Secondary muscles</dt><dd>{exercise.secondaryMuscles.join(', ') || 'None listed'}</dd></div><div class="metadata-card" data-squircle data-radius="32"><dt>Exercise type</dt><dd>{typeLabel}</dd></div></dl>
    </section>

    <section class="section guide-layout" aria-labelledby="credit-title">
      <div><p class="eyebrow">License</p><h2 id="credit-title">Attribution.</h2></div>
      <div class="guide-card" data-squircle data-radius="32"><p>Illustration by <a href={exercise.attribution.creatorUrl}>{exercise.attribution.creator}</a>, licensed under <a href={exercise.attribution.licenseUrl}>{exercise.attribution.license}</a>.</p>{exercise.attribution.source && <p>Frame 1 is derived from {exercise.attribution.source.name}. {exercise.attribution.source.changes}</p>}</div>
    </section>
  </article>
</BaseLayout>
