---
import { withBase } from '../../lib/paths';
import '../../coach/coach.css';

const base = withBase('');
---

<!doctype html>
<html lang="en-GB" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content="A personal 24-week training plan: today's session, timers, weigh-ins and progress." />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <script is:inline>
      // Pick the theme before anything is drawn. iOS reads the status-bar style when the app launches,
      // so it is written here too: white text over dark, black text on a light bar.
      (function () {
        var theme = 'system';
        try { theme = (JSON.parse(localStorage.getItem('coach:v1') || '{}').settings || {}).theme || 'system'; } catch (e) {}
        var dark = theme === 'dark' || (theme === 'system' && !matchMedia('(prefers-color-scheme: light)').matches);
        document.documentElement.setAttribute('data-theme', dark ? 'dark' : 'light');
        var head = document.head;
        var sb = document.createElement('meta');
        sb.name = 'apple-mobile-web-app-status-bar-style';
        sb.content = dark ? 'black-translucent' : 'default';
        head.appendChild(sb);
        var tc = document.createElement('meta');
        tc.name = 'theme-color';
        tc.content = dark ? '#101010' : '#f2f2ee';
        head.appendChild(tc);
      })();
    </script>
    <meta name="apple-mobile-web-app-title" content="Coach" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="manifest" href={withBase('coach/manifest.webmanifest')} />
    <link rel="apple-touch-icon" href={withBase('coach/icons/apple-touch-icon.png')} />
    <link rel="icon" href={withBase('coach/icons/icon-192.png')} type="image/png" />
    <title>Coach</title>
  </head>
  <body>
    <div id="app" data-base={base}>
      <main class="view" id="view" tabindex="-1">
        <noscript><p style="padding:24px">Coach needs JavaScript turned on.</p></noscript>
      </main>
      <nav class="tabbar" id="tabbar" aria-label="Sections" hidden></nav>
      <section class="session" id="session" role="dialog" aria-modal="true" aria-label="Workout session" hidden></section>
      <div class="confirm" id="confirm" hidden>
        <div class="card" role="alertdialog" aria-labelledby="confirm-title">
          <h3 id="confirm-title">End this session?</h3>
          <p class="note">The day stays not done unless you finish it or mark it done.</p>
          <button class="btn danger" data-end="yes">End session</button>
          <button class="btn ghost" data-end="no">Keep going</button>
        </div>
      </div>
      <div class="update-bar" id="update-bar" role="status" hidden>
        <span>A new version of Coach is ready.</span><button data-reload>Reload</button>
      </div>
      <div class="toast" id="toast" role="status" aria-live="polite"></div>
    </div>
    <script>
      import '../../coach/app';
    </script>
  </body>
</html>
