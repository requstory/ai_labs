---
import { exercises } from '@bryllim/workout-guide';
import ExerciseCard from '../components/ExerciseCard.astro';
import InstallPrompt from '../components/InstallPrompt.astro';
import TodayCard from '../components/TodayCard.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/paths';

const featuredNames = ['Push-up', 'Squat', 'Deadlift', 'Pull-up', 'Plank'];
const featured = featuredNames
  .map((name) => exercises.find((exercise) => exercise.name.toLowerCase() === name.toLowerCase()))
  .filter((exercise): exercise is (typeof exercises)[number] => Boolean(exercise));
const previews = featured.length === 5 ? featured : exercises.slice(0, 5);
---

<BaseLayout
  title="FitSplit — Your 5-day fitness plan"
  description="A free 5-day training split with 302 illustrated exercises. Pick a day, see exactly what to do, and go. No sign-up, no ads, works offline."
>
  <section class="hero page-shell" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="eyebrow stagger-item">Free · No sign-up · Works offline</p>
      <h1 class="stagger-item" id="hero-title">Get fit, one day at a time.</h1>
      <p class="stagger-item">A simple 5-day training split with 302 illustrated exercises. Pick a day, see exactly what to train, and go.</p>
      <div class="stagger-item">
        <div class="hero-actions">
          <a class="action-link focus-shell" href={withBase('plan/')}><span class="button-surface button-surface-dark" data-squircle data-radius="18">Start your plan</span></a>
          <a class="action-link focus-shell" href={withBase('exercises/')}><span class="button-surface button-surface-light" data-squircle data-radius="18">Browse exercises</span></a>
        </div>
      </div>
    </div>
    <TodayCard />
  </section>

  <section class="stats page-shell" aria-label="FitSplit at a glance">
    <div class="stat-card" data-squircle data-radius="32"><strong class="stat-value">5</strong><span class="stat-label">Day plan</span></div>
    <div class="stat-card" data-squircle data-radius="32"><strong class="stat-value">302</strong><span class="stat-label">Exercises</span></div>
    <div class="stat-card" data-squircle data-radius="32"><strong class="stat-value">0</strong><span class="stat-label">Cost, ever</span></div>
  </section>

  <section class="section page-shell" aria-labelledby="featured-title">
    <div class="section-heading"><div><p class="eyebrow">The library</p><h2 id="featured-title">Every move, illustrated.</h2></div><a href={withBase('exercises/')}>View all 302</a></div>
    <div class="preview-grid">{previews.map((exercise) => <ExerciseCard exercise={exercise} />)}</div>
  </section>

  <section class="section page-shell" aria-labelledby="benefits-title">
    <div class="section-heading"><div><p class="eyebrow">Why FitSplit</p><h2 id="benefits-title">Made to keep you moving.</h2></div><p>No ads, no tracking, no account required — just a plan and a library.</p></div>
    <div class="feature-grid">
      <article class="feature-card" data-squircle data-radius="32"><span class="feature-number">01</span><h3>Structured, not random</h3><p>A day-by-day split tells you exactly what to train, so you never have to guess.</p></article>
      <article class="feature-card" data-squircle data-radius="32"><span class="feature-number">02</span><h3>See the movement</h3><p>Every exercise animates through its full range of motion, not just one static pose.</p></article>
      <article class="feature-card" data-squircle data-radius="32"><span class="feature-number">03</span><h3>Yours to keep</h3><p>Install it like an app and it works offline, anywhere you train.</p></article>
    </div>
  </section>

  <section class="section page-shell" aria-labelledby="install-title">
    <h2 class="sr-only" id="install-title">Install FitSplit</h2>
    <InstallPrompt />
  </section>
</BaseLayout>
