---
import type { Exercise } from '@bryllim/workout-guide';
import { frameUrl, withBase } from '../lib/paths';
import { muscleColor } from '../lib/muscleColor';
import { exerciseLocation } from '../lib/location';

type Props = {
  exercise: Exercise;
};

const { exercise } = Astro.props;
const searchText = [
  exercise.name,
  exercise.equipment,
  exercise.primaryMuscle,
  ...exercise.secondaryMuscles,
].join(' ').toLowerCase();
---

<article
  class="exercise-card"
  data-exercise-card
  data-search={searchText}
  data-equipment={exercise.equipment}
  data-muscle={exercise.primaryMuscle}
  data-type={exercise.exerciseType}
  data-location={exerciseLocation(exercise)}
>
  <a class="card-link focus-shell" href={withBase(`exercises/${exercise.slug}/`)}>
    <div class="card-surface" data-squircle data-radius="28">
      <span
        class="card-image frame-mask"
        role="img"
        aria-label={`${exercise.name} exercise illustration`}
        data-frames={JSON.stringify(exercise.frames.map((frame) => frameUrl(exercise.slug, frame)))}
        style={`--frame-tint:${muscleColor(exercise.primaryMuscle)}; -webkit-mask-image:url(${frameUrl(exercise.slug, 1)}); mask-image:url(${frameUrl(exercise.slug, 1)})`}
      />
      <div class="card-copy">
        <h2>{exercise.name}</h2>
        <p>{exercise.primaryMuscle} · {exercise.equipment}</p>
      </div>
    </div>
  </a>
</article>
